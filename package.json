{
  "name": "campusone-web-application",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CampusOne web application: institution console, operator back office, admissions, customer portal and terminal (one Angular app).",
  "author": "SABADO Technologies",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.11 <25",
    "npm": ">=11"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "start:http": "ng serve",
    "start:lan": "node scripts/serve.mjs",
    "build": "ng build",
    "test": "npm run tokens:check && npm run ui-text:check && ng test --watch=false",
    "e2e": "playwright test",
    "e2e:journeys": "playwright test -c playwright.journeys.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "tokens:css": "tsx scripts/tokens-css.ts",
    "tokens:check": "tsx scripts/tokens-css.ts --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prototype:port": "tsx scripts/port-prototype.ts",
    "prototype:check": "tsx scripts/port-prototype.ts --check",
    "ui-text": "tsx scripts/ui-text.ts",
    "ui-text:check": "tsx scripts/ui-text.ts --check",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "24.19.1",
    "angular-eslint": "22.5.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "27.4.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11"
  }
}
