{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CampusOne Card Reader",
  "version": "1.1.1",
  "identifier": "in.campusone.cardreader",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "title": "CampusOne Card Reader",
        "width": 480,
        "height": 420,
        "minWidth": 380,
        "minHeight": 360,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/campusone_logo.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "campusone-reader"
        ]
      }
    }
  }
}
